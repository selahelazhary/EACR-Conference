{
  "rules": {
    ".read": false,
    ".write": false,

    "site_config": {
      ".read": true,
      ".write": "auth != null"
    },

    "sponsors": {
      ".read": true,
      ".write": "auth != null",
      "$sponsor": {
        ".validate": "newData.hasChildren(['name']) || newData.hasChildren(['logo'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "logo": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "url": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "tier": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "order": { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "categories": { ".read": true, ".write": "auth != null" },
    "site_texts": { ".read": true, ".write": "auth != null" },
    "config": { ".read": true, ".write": "auth != null" },
    "pulse": { ".read": true, ".write": "auth != null" },

    "engagement": {
      ".read": true,
      "$type": {
        "$item": {
          "views": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() <= 1 : (newData.val() > data.val() && newData.val() <= data.val() + 1))"
          },
          "likes": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() <= 1 : (newData.val() <= data.val() + 1 && newData.val() >= data.val() - 1))"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "comments": {
      ".read": true,
      "$type": {
        "$item": {
          "$comment": {
            ".write": "auth != null || (!data.exists() && newData.exists())",
            ".validate": "newData.hasChildren(['body', 'at']) && newData.child('body').isString() && newData.child('body').val().length >= 3 && newData.child('body').val().length <= 1200 && newData.child('at').isNumber()",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "body": { ".validate": "newData.isString() && newData.val().length <= 1200" },
            "at": { ".validate": "newData.isNumber()" },
            "approved": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "$section": {
      ".read": true,
      ".write": "auth != null",
      "$item": {
        ".validate": "newData.hasChildren(['title'])"
      }
    }
  }
}
